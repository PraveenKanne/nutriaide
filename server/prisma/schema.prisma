// server/prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String?
  dob          DateTime?
  sex          String?
  locale       String    @default("en-IN")
  allergies    String[]  @db.Text
  conditions   String[]  @db.Text
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  mealLogs     MealLog[]
  medications  Medication[]
  vitals       Vital[]
  shareGrants  ShareGrant[]
  scanRecords  ScanRecord[]
}

model FoodItem {
  id              String    @id @default(cuid())
  barcode         String?   @unique
  name            String
  brand           String?
  category        String?
  servingUnit     String    @default("g")
  servingValue    Float     @default(100)
  nutrients       Json
  ingredients     String[]  @db.Text
  additives       String[]  @db.Text
  allergens       String[]  @db.Text
  shelfLife       Json
  processingLevel String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  scanRecords     ScanRecord[]
  mealLogs        MealLog[]
}

model ScanRecord {
  id         String   @id @default(cuid())
  userId     String
  foodItemId String
  method     String
  confidence Float
  rawText    String?
  imageRef   String?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id])
  food       FoodItem @relation(fields: [foodItemId], references: [id])
}

model MealLog {
  id         String   @id @default(cuid())
  userId     String
  foodItemId String
  grams      Float?
  servings   Float?
  mealType   String
  timestamp  DateTime
  notes      String?
  user       User     @relation(fields: [userId], references: [id])
  food       FoodItem @relation(fields: [foodItemId], references: [id])
}

model Medication {
  id         String   @id @default(cuid())
  userId     String
  name       String
  dose       Float
  unit       String
  route      String
  schedule   Json
  start      DateTime
  end        DateTime?
  prescriber String?
  user       User     @relation(fields: [userId], references: [id])
  intakes    MedicationIntake[]
}

model MedicationIntake {
  id           String   @id @default(cuid())
  medicationId String
  takenAt      DateTime
  dose         Float?
  missedReason String?
  medication   Medication @relation(fields: [medicationId], references: [id])
}

model Vital {
  id         String   @id @default(cuid())
  userId     String
  type       String
  value      Float
  unit       String
  measuredAt DateTime
  user       User     @relation(fields: [userId], references: [id])
}

model Doctor {
  id           String   @id @default(cuid())
  name         String
  clinic       String?
  contact      String?
  fhirEndpoint String?
  patients     ShareGrant[]
}

model ShareGrant {
  id        String   @id @default(cuid())
  userId    String
  doctorId  String?
  scopes    String[] @db.Text
  expiresAt DateTime
  tokenHash String   @unique
  user      User     @relation(fields: [userId], references: [id])
  doctor    Doctor?  @relation(fields: [doctorId], references: [id])
}
